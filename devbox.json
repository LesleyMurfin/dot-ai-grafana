{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.26.5",
    "nodejs@22.23.2",
    "mage@1.17.2",
    "gh@2.98.0",
    "git@2.55.0",
    "jq@1.8.2",
    "ripgrep@15.2.0",
    "curl@8.17.0",
    "zip@3.0",
    "shellcheck@0.11.0",
    "golangci-lint@2.13.1",
    "python@3.12.14",
    "python312Packages.towncrier@24.8.0",
    "python312Packages.pyyaml@6.0.3"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$HOME/.local/bin:$PATH\"",
      "export PATH=\"$PWD/node_modules/.bin:$PATH\"",
      "export PYTHONPATH=\"${DEVBOX_PACKAGES_DIR:-$PWD/.devbox/nix/profile/default}/lib/python3.12/site-packages${PYTHONPATH:+:$PYTHONPATH}\"",
      "[ -f .env ] && source .env || true"
    ],
    "scripts": {
      "agent":              ["claude"],
      "agent-plan":         ["claude --model opus --permission-mode plan"],
      "agent-small":        ["claude --model haiku"],
      "agent-big":          ["claude --model opus"],
      "agent-orchestrator": ["claude --model opus"],
      "agent-coder":        ["claude --model opus"],
      "agent-reviewer":     ["claude --model opus"],
      "agent-auditor":      ["claude --model opus"],
      "agent-tester":       ["claude --model opus"],
      "agent-release":      ["claude --model sonnet"]
    }
  }
}
